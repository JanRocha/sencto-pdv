procedure TFrmPDV.MenuItemClick(Sender: TObject);
begin
  if not (Sender is TRectangle) then
    Exit;
  DestacarMenu(TRectangle(Sender).Tag);
  if TRectangle(Sender).Tag <> 0 then
    TDialogService.ShowMessage('Modulo em construcao.');
end;

procedure TFrmPDV.DestacarMenu(ATag: Integer);
var
  I, J: Integer;
  LItem: TRectangle;
  LObj: TFmxObject;
begin
  for I := 0 to High(FMenuItens) do
  begin
    LItem := FMenuItens[I];
    if LItem.Tag = ATag then
    begin
      LItem.Fill.Kind := TBrushKind.Solid;
      LItem.Fill.Color := TTheme.CorPrincipalLight;
    end
    else
      LItem.Fill.Kind := TBrushKind.None;

    for J := 0 to LItem.ChildrenCount - 1 do
    begin
      LObj := LItem.Children[J];
      if (LObj is TLabel) and (TLabel(LObj).Align = TAlignLayout.Client) then
      begin
        if LItem.Tag = ATag then
        begin
          TLabel(LObj).TextSettings.Font.Style := [TFontStyle.fsBold];
          TLabel(LObj).TextSettings.FontColor := TTheme.CorPrincipal;
        end
        else
        begin
          TLabel(LObj).TextSettings.Font.Style := [];
          TLabel(LObj).TextSettings.FontColor := TTheme.CorTextoSecundario;
        end;
      end
      else if (LObj is TLabel) and (TLabel(LObj).Align = TAlignLayout.Left) then
      begin
        if LItem.Tag = ATag then
          TLabel(LObj).TextSettings.FontColor := TTheme.CorPrincipal
        else
          TLabel(LObj).TextSettings.FontColor := TTheme.CorTextoSecundario;
      end;
    end;
  end;
end;

