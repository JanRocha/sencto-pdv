procedure TFrmPDV.BtnFinalizarClick(Sender: TObject);
begin
  if FControllerVenda.Carrinho.Count = 0 then
  begin
    TDialogService.ShowMessage('Carrinho vazio. Adicione produtos antes de finalizar.');
    Exit;
  end;
  ExibirDialogPagamento;
end;

procedure TFrmPDV.BtnCancelarClick(Sender: TObject);
begin
  if FControllerVenda.Carrinho.Count = 0 then
    Exit;
  TDialogService.MessageDialog(
    'Cancelar a venda atual? Todos os itens serao removidos.',
    TMsgDlgType.mtConfirmation,
    [TMsgDlgBtn.mbYes, TMsgDlgBtn.mbNo], TMsgDlgBtn.mbNo, 0,
    procedure(const AResult: TModalResult)
    begin
      if AResult = mrYes then
      begin
        FControllerVenda.CancelarVenda;
        EdtDesconto.Text := '0,00';
        AtualizarCarrinho;
      end;
    end);
end;

procedure TFrmPDV.BtnSalvarClick(Sender: TObject);
begin
  TDialogService.ShowMessage('Venda salva em rascunho.');
end;

procedure TFrmPDV.EdtBuscaChange(Sender: TObject);
begin
  { Pode disparar durante o carregamento do .fmx, antes do FormCreate }
  if not Assigned(FProdutos) then
    Exit;
  RenderizarProdutos;
end;

procedure TFrmPDV.FormKeyDown(Sender: TObject; var Key: Word;
  var KeyChar: Char; Shift: TShiftState);
begin
  case Key of
    vkF2:
      begin
        EdtBusca.SetFocus;
        Key := 0;
      end;
    vkF3:
      begin
        BtnSalvarClick(nil);
        Key := 0;
      end;
    vkF5:
      begin
        BtnFinalizarClick(nil);
        Key := 0;
      end;
    vkEscape:
      begin
        BtnCancelarClick(nil);
        Key := 0;
      end;
  end;
end;

