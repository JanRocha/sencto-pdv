procedure TFrmPDV.AtualizarTotais;
begin
  lblSubtotalVal.Text := FormatarMoeda(FControllerVenda.CalcularSubtotal);
  lblDescontoVal.Text := '- ' + FormatarMoeda(FControllerVenda.Desconto);
  lblTotalVal.Text := FormatarMoeda(FControllerVenda.CalcularTotal);
end;

procedure TFrmPDV.BtnMaisClick(Sender: TObject);
var
  LIndex: Integer;
  LItem: TVendaItem;
begin
  if not (Sender is TRectangle) then Exit;
  LIndex := TRectangle(Sender).Tag;
  if (LIndex < 0) or (LIndex >= FControllerVenda.Carrinho.Count) then Exit;
  LItem := FControllerVenda.Carrinho[LIndex];
  try
    FControllerVenda.AlterarQuantidade(LIndex, LItem.Quantidade + 1);
    AtualizarCarrinho;
  except
    on E: Exception do
      TDialogService.ShowMessage(E.Message);
  end;
end;

procedure TFrmPDV.BtnMenosClick(Sender: TObject);
var
  LIndex: Integer;
  LItem: TVendaItem;
begin
  if not (Sender is TRectangle) then Exit;
  LIndex := TRectangle(Sender).Tag;
  if (LIndex < 0) or (LIndex >= FControllerVenda.Carrinho.Count) then Exit;
  LItem := FControllerVenda.Carrinho[LIndex];
  if LItem.Quantidade <= 1 then
    FControllerVenda.RemoverItem(LIndex)
  else
  begin
    try
      FControllerVenda.AlterarQuantidade(LIndex, LItem.Quantidade - 1);
    except
      on E: Exception do
        TDialogService.ShowMessage(E.Message);
    end;
  end;
  AtualizarCarrinho;
end;

procedure TFrmPDV.BtnRemoverClick(Sender: TObject);
var
  LIndex: Integer;
begin
  if not (Sender is TRectangle) then Exit;
  LIndex := TRectangle(Sender).Tag;
  if (LIndex < 0) or (LIndex >= FControllerVenda.Carrinho.Count) then Exit;
  FControllerVenda.RemoverItem(LIndex);
  AtualizarCarrinho;
end;

procedure TFrmPDV.EdtDescontoChange(Sender: TObject);
var
  LValor: Currency;
  LTexto: string;
begin
  { Pode disparar durante o carregamento do .fmx, antes do FormCreate }
  if not Assigned(FControllerVenda) then
    Exit;

  LTexto := Trim(StringReplace(EdtDesconto.Text, ',', '.', [rfReplaceAll]));
  if LTexto = '' then
    LValor := 0
  else
    LValor := StrToCurrDef(LTexto, 0);
  try
    FControllerVenda.AplicarDesconto(LValor);
  except
    FControllerVenda.AplicarDesconto(0);
  end;
  AtualizarTotais;
end;

