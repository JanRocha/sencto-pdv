unit Frm.PDV;

interface

uses
  System.SysUtils,
  System.Types,
  System.UITypes,
  System.Classes,
  System.Math,
  System.Generics.Collections,
  FMX.Types,
  FMX.Forms,
  FMX.Controls,
  FMX.StdCtrls,
  FMX.Layouts,
  FMX.Objects,
  FMX.Effects,
  FMX.Ani,
  FMX.Edit,
  FMX.ListBox,
  FMX.Controls.Presentation,
  FMX.Graphics,
  FMX.DialogService,
  Utils.Theme,
  Model.Entidade.Categoria,
  Model.Entidade.Produto,
  Model.Entidade.VendaItem,
  Controller.Venda;

type
  /// <summary>
  /// Tela principal de PDV para Parque Infantil.
  /// O layout visual (3 secoes: menu lateral, area central, painel de venda)
  /// e definido no Frm.PDV.fmx (editavel no Designer).
  /// Esta unit apenas:
  ///   - Popula os chips de categoria (ScrollChips)
  ///   - Renderiza os cards de produto (FlowProdutos) com base nos dados
  ///   - Renderiza os itens do carrinho (ScrollItens)
  ///   - Trata eventos (clique, busca, desconto, finalizacao, atalhos)
  /// </summary>
  TFrmPDV = class(TForm)
    { ===== Componentes publicados do .fmx ===== }
    RectRoot: TRectangle;

    { Secao 1 - Menu lateral }
    LayoutSidebar: TLayout;
    RectSidebarBg: TRectangle;
    RectSidebarBorder: TRectangle;
    LayoutLogo: TLayout;
    RectLogoIcon: TRectangle;
    lblLogoIcon: TLabel;
    lblLogoTitulo: TLabel;
    lblLogoSub: TLabel;
    lblMenuCap: TLabel;
    LayoutMenu: TLayout;
    ItemVenda: TRectangle;
    lblIconVenda: TLabel;
    lblTextVenda: TLabel;
    ItemProdutos: TRectangle;
    lblIconProdutos: TLabel;
    lblTextProdutos: TLabel;
    ItemClientes: TRectangle;
    lblIconClientes: TLabel;
    lblTextClientes: TLabel;
    ItemIngressos: TRectangle;
    lblIconIngressos: TLabel;
    lblTextIngressos: TLabel;
    ItemCaixa: TRectangle;
    lblIconCaixa: TLabel;
    lblTextCaixa: TLabel;
    ItemRelatorios: TRectangle;
    lblIconRelatorios: TLabel;
    lblTextRelatorios: TLabel;
    ItemConfig: TRectangle;
    lblIconConfig: TLabel;
    lblTextConfig: TLabel;
    LayoutOperador: TLayout;
    RectOperadorSep: TRectangle;
    lblOperadorAvatar: TLabel;
    lblOperadorNome: TLabel;
    lblOperadorPapel: TLabel;
    BtnLogout: TRectangle;
    lblLogout: TLabel;

    { Secao 2 - Area central }
    LayoutCentral: TLayout;
    LayoutBusca: TLayout;
    RectBusca: TRectangle;
    lblBuscaIcon: TLabel;
    lblAtalhoF2: TLabel;
    EdtBusca: TEdit;
    lblProdutosTitulo: TLabel;
    LayoutChips: TLayout;
    ScrollChips: THorzScrollBox;
    LayoutAcoes: TLayout;
    RectAcoesBar: TRectangle;
    lblAcoesInfo: TLabel;
    lblVersao: TLabel;
    ScrollProdutos: TVertScrollBox;
    FlowProdutos: TFlowLayout;

    { Secao 3 - Painel de venda }
    LayoutVenda: TLayout;
    RectVendaBg: TRectangle;
    RectVendaBorder: TRectangle;
    LayoutVendaHeader: TLayout;
    lblVendaTitulo: TLabel;
    LayoutVendaFooter: TLayout;
    LayoutBotoesSec: TLayout;
    BtnCancelar: TRectangle;
    lblCancelar: TLabel;
    BtnSalvar: TRectangle;
    lblSalvar: TLabel;
    BtnFinalizar: TRectangle;
    lblFinalizar: TLabel;
    RowTotal: TLayout;
    lblTotalCap: TLabel;
    lblTotalVal: TLabel;
    RowDesconto: TLayout;
    lblDescontoCap: TLabel;
    lblDescontoVal: TLabel;
    RowSubtotal: TLayout;
    lblSubtotalCap: TLabel;
    lblSubtotalVal: TLabel;
    RectDesconto: TRectangle;
    EdtDesconto: TEdit;
    lblDescontoPerc: TLabel;
    ScrollItens: TVertScrollBox;

    { ===== Eventos publicados ===== }
    procedure FormCreate(Sender: TObject);
    procedure FormDestroy(Sender: TObject);
    procedure MenuItemClick(Sender: TObject);
    procedure BtnLogoutClick(Sender: TObject);
    procedure BtnFinalizarClick(Sender: TObject);
    procedure BtnCancelarClick(Sender: TObject);
    procedure BtnSalvarClick(Sender: TObject);
    procedure EdtBuscaChange(Sender: TObject);
    procedure EdtDescontoChange(Sender: TObject);
    procedure FormKeyDown(Sender: TObject; var Key: Word; var KeyChar: Char;
      Shift: TShiftState);
  private
    { Colaborador logado }
    FColaboradorId: Integer;
    FColaboradorNome: string;
    FColaboradorPapel: string;
    FCaixaId: Integer;

    { Controller }
    FControllerVenda: TControllerVenda;

    { Dados Mock }
    FCategorias: TObjectList<TCategoria>;
    FProdutos: TObjectList<TProduto>;
    FCategoriaSelecionadaId: Integer;

    { Itens de menu (para destaque de selecao) }
    FMenuItens: TArray<TRectangle>;

    { --- Chips de categoria --- }
    procedure RenderizarChips;
    function CriarChip(const ATexto: string; ATag: Integer): TRectangle;
    procedure ChipClick(Sender: TObject);
    procedure AtualizarChipAtivo;

    { --- Produtos --- }
    procedure RenderizarProdutos;
    function CriarCardProduto(AProduto: TProduto): TRectangle;
    procedure CardMouseEnter(Sender: TObject);
    procedure CardMouseLeave(Sender: TObject);
    procedure ProdutoCardClick(Sender: TObject);

    { --- Carrinho --- }
    procedure AtualizarCarrinho;
    procedure RenderizarItensCarrinho;
    procedure AtualizarTotais;
    procedure BtnMaisClick(Sender: TObject);
    procedure BtnMenosClick(Sender: TObject);
    procedure BtnRemoverClick(Sender: TObject);

    { --- Menu lateral --- }
    procedure DestacarMenu(ATag: Integer);

    { --- Pagamento --- }
    procedure ExibirDialogPagamento;

    { --- Helpers --- }
    procedure PopularDadosMock;
    procedure ConfigurarOperador;
    function FormatarMoeda(AValor: Currency): string;
    function GetProdutoPorId(AId: Integer): TProduto;

    procedure SetColaboradorNome(const AValue: string);
    procedure SetColaboradorPapel(const AValue: string);
    procedure SetCaixaId(const AValue: Integer);
  public
    constructor Create(AOwner: TComponent; AColaboradorId: Integer;
      const AColaboradorNome, AColaboradorPapel: string;
      ACaixaId: Integer = 1); reintroduce; overload;

    property ColaboradorId: Integer read FColaboradorId write FColaboradorId;
    property ColaboradorNome: string read FColaboradorNome write SetColaboradorNome;
    property ColaboradorPapel: string read FColaboradorPapel write SetColaboradorPapel;
    property CaixaId: Integer read FCaixaId write SetCaixaId;
  end;

var
  FrmPDV: TFrmPDV;

implementation

{$R *.fmx}

type
  /// Helper para acessar Scale (protegido em TControl no Delphi 10.2)
  TControlScaleHelper = class helper for TControl
  public
    procedure SetEscala(AValor: Single);
  end;

procedure TControlScaleHelper.SetEscala(AValor: Single);
begin
  Self.Scale.X := AValor;
  Self.Scale.Y := AValor;
end;

const
  CARD_WIDTH  = 180;
  CARD_HEIGHT = 220;
  CHIP_HEIGHT = 36;
  CHIP_SPACING = 8;

{ ============================================================
  CONSTRUTOR
  ============================================================ }

constructor TFrmPDV.Create(AOwner: TComponent; AColaboradorId: Integer;
  const AColaboradorNome, AColaboradorPapel: string; ACaixaId: Integer);
begin
  FColaboradorId := AColaboradorId;
  FColaboradorNome := AColaboradorNome;
  FColaboradorPapel := AColaboradorPapel;
  FCaixaId := ACaixaId;
  inherited Create(AOwner);
end;

procedure TFrmPDV.FormCreate(Sender: TObject);
begin
  FCategoriaSelecionadaId := 0;

  FControllerVenda := TControllerVenda.Create;
  FCategorias := TObjectList<TCategoria>.Create(True);
  FProdutos := TObjectList<TProduto>.Create(True);

  FMenuItens := [ItemVenda, ItemProdutos, ItemClientes, ItemIngressos,
                 ItemCaixa, ItemRelatorios, ItemConfig];

  ConfigurarOperador;
  PopularDadosMock;
  RenderizarChips;
  RenderizarProdutos;
  AtualizarCarrinho;
end;

procedure TFrmPDV.FormDestroy(Sender: TObject);
begin
  FProdutos.Free;
  FCategorias.Free;
  FControllerVenda.Free;
end;

procedure TFrmPDV.ConfigurarOperador;
begin
  lblOperadorNome.Text := FColaboradorNome;
  lblOperadorPapel.Text := FColaboradorPapel;
  lblAcoesInfo.Text := Format('Caixa: %0.3d   |   Operador: %s   |   Turno: 1   |   Online',
    [FCaixaId, FColaboradorNome]);
end;

procedure TFrmPDV.SetColaboradorNome(const AValue: string);
begin
  FColaboradorNome := AValue;
  if Assigned(lblOperadorNome) then
    lblOperadorNome.Text := AValue;
  if Assigned(lblAcoesInfo) then
    lblAcoesInfo.Text := Format('Caixa: %0.3d   |   Operador: %s   |   Turno: 1   |   Online',
      [FCaixaId, FColaboradorNome]);
end;

procedure TFrmPDV.SetColaboradorPapel(const AValue: string);
begin
  FColaboradorPapel := AValue;
  if Assigned(lblOperadorPapel) then
    lblOperadorPapel.Text := AValue;
end;

procedure TFrmPDV.SetCaixaId(const AValue: Integer);
begin
  FCaixaId := AValue;
  if Assigned(lblAcoesInfo) then
    lblAcoesInfo.Text := Format('Caixa: %0.3d   |   Operador: %s   |   Turno: 1   |   Online',
      [FCaixaId, FColaboradorNome]);
end;

{ ============================================================
  CHIPS DE CATEGORIA
  ============================================================ }

procedure TFrmPDV.RenderizarChips;
var
  I: Integer;
  LChip: TRectangle;
  LPosX: Single;
begin
  ScrollChips.Content.DeleteChildren;
  LPosX := 0;

  { Chip "Todos" }
  LChip := CriarChip('Todos', 0);
  LChip.Parent := ScrollChips;
  LChip.Position.X := LPosX;
  LChip.Position.Y := 8;
  LPosX := LPosX + LChip.Width + CHIP_SPACING;

  { Chips das categorias }
  for I := 0 to FCategorias.Count - 1 do
  begin
    LChip := CriarChip(FCategorias[I].Nome, FCategorias[I].Id);
    LChip.Parent := ScrollChips;
    LChip.Position.X := LPosX;
    LChip.Position.Y := 8;
    LPosX := LPosX + LChip.Width + CHIP_SPACING;
  end;
end;

function TFrmPDV.CriarChip(const ATexto: string; ATag: Integer): TRectangle;
var
  LLbl: TLabel;
begin
  Result := TRectangle.Create(Self);
  Result.Width := Length(ATexto) * 8 + 32;
  Result.Height := CHIP_HEIGHT;
  Result.XRadius := CHIP_HEIGHT / 2;
  Result.YRadius := CHIP_HEIGHT / 2;
  Result.Stroke.Kind := TBrushKind.None;
  Result.Fill.Kind := TBrushKind.Solid;
  Result.Tag := ATag;
  Result.Cursor := crHandPoint;
  Result.HitTest := True;
  Result.OnClick := ChipClick;

  if ATag = FCategoriaSelecionadaId then
    Result.Fill.Color := TTheme.CorPrincipal
  else
    Result.Fill.Color := TTheme.CorFundoSecundario;

  LLbl := TLabel.Create(Self);
  LLbl.Parent := Result;
  LLbl.Align := TAlignLayout.Client;
  LLbl.Text := ATexto;
  LLbl.StyledSettings := [];
  LLbl.TextSettings.Font.Size := TTheme.FontNormal;
  LLbl.TextSettings.HorzAlign := TTextAlign.Center;
  LLbl.TextSettings.VertAlign := TTextAlign.Center;
  LLbl.HitTest := False;

  if ATag = FCategoriaSelecionadaId then
  begin
    LLbl.TextSettings.Font.Style := [TFontStyle.fsBold];
    LLbl.TextSettings.FontColor := TTheme.CorTextoBranco;
  end
  else
    LLbl.TextSettings.FontColor := TTheme.CorTextoSecundario;
end;

procedure TFrmPDV.ChipClick(Sender: TObject);
begin
  if Sender is TRectangle then
  begin
    FCategoriaSelecionadaId := TRectangle(Sender).Tag;
    AtualizarChipAtivo;
    RenderizarProdutos;
  end;
end;

procedure TFrmPDV.AtualizarChipAtivo;
var
  I, J: Integer;
  LChip: TRectangle;
  LObj: TFmxObject;
begin
  for I := 0 to ScrollChips.Content.ChildrenCount - 1 do
  begin
    if not (ScrollChips.Content.Children[I] is TRectangle) then
      Continue;
    LChip := TRectangle(ScrollChips.Content.Children[I]);

    if LChip.Tag = FCategoriaSelecionadaId then
      LChip.Fill.Color := TTheme.CorPrincipal
    else
      LChip.Fill.Color := TTheme.CorFundoSecundario;

    for J := 0 to LChip.ChildrenCount - 1 do
    begin
      LObj := LChip.Children[J];
      if LObj is TLabel then
      begin
        if LChip.Tag = FCategoriaSelecionadaId then
        begin
          TLabel(LObj).TextSettings.Font.Style := [TFontStyle.fsBold];
          TLabel(LObj).TextSettings.FontColor := TTheme.CorTextoBranco;
        end
        else
        begin
          TLabel(LObj).TextSettings.Font.Style := [];
          TLabel(LObj).TextSettings.FontColor := TTheme.CorTextoSecundario;
        end;
      end;
    end;
  end;
end;

{ ============================================================
  PRODUTOS (cards)
  ============================================================ }

procedure TFrmPDV.RenderizarProdutos;
var
  I: Integer;
  LCard: TRectangle;
  LBusca: string;
  LContador: Integer;
  LColunas: Integer;
begin
  FlowProdutos.BeginUpdate;
  try
    FlowProdutos.DeleteChildren;
    LBusca := LowerCase(Trim(EdtBusca.Text));
    LContador := 0;

    for I := 0 to FProdutos.Count - 1 do
    begin
      if FProdutos[I].Situacao <> 1 then
        Continue;
      if (FCategoriaSelecionadaId <> 0) and
         (FProdutos[I].Categoria_Id <> FCategoriaSelecionadaId) then
        Continue;
      if (LBusca <> '') and
         (Pos(LBusca, LowerCase(FProdutos[I].Nome)) = 0) then
        Continue;

      LCard := CriarCardProduto(FProdutos[I]);
      LCard.Parent := FlowProdutos;
      Inc(LContador);
    end;
  finally
    FlowProdutos.EndUpdate;
  end;

  { Ajusta altura do FlowLayout para o scroll }
  LColunas := Max(1, Trunc(FlowProdutos.Width / (CARD_WIDTH + 16)));
  FlowProdutos.Height := (Ceil(LContador / LColunas)) * (CARD_HEIGHT + 16) + 16;
end;

function TFrmPDV.CriarCardProduto(AProduto: TProduto): TRectangle;
var
  LRectImg: TRectangle;
  LLblEmoji: TLabel;
  LLblNome: TLabel;
  LLblPreco: TLabel;
  LShadow: TShadowEffect;
  LBadge: TRectangle;
  LLblBadge: TLabel;
begin
  Result := TRectangle.Create(Self);
  Result.Width := CARD_WIDTH;
  Result.Height := CARD_HEIGHT;
  Result.XRadius := TTheme.CardRadius;
  Result.YRadius := TTheme.CardRadius;
  Result.Fill.Kind := TBrushKind.Solid;
  Result.Fill.Color := TTheme.CorFundoCard;
  Result.Stroke.Kind := TBrushKind.Solid;
  Result.Stroke.Color := TTheme.CorBorda;
  Result.Stroke.Thickness := 1;
  Result.Tag := AProduto.Id;
  Result.Cursor := crHandPoint;
  Result.HitTest := True;
  Result.OnClick := ProdutoCardClick;
  Result.OnMouseEnter := CardMouseEnter;
  Result.OnMouseLeave := CardMouseLeave;

  { Sombra suave }
  LShadow := TShadowEffect.Create(Result);
  LShadow.Parent := Result;
  LShadow.Distance := 3;
  LShadow.Direction := 90;
  LShadow.Softness := 0.3;
  LShadow.Opacity := 0.12;
  LShadow.ShadowColor := TAlphaColorRec.Black;

  { Area da imagem (circulo com emoji) }
  LRectImg := TRectangle.Create(Self);
  LRectImg.Parent := Result;
  LRectImg.Align := TAlignLayout.None;
  LRectImg.Position.X := (CARD_WIDTH - 88) / 2;
  LRectImg.Position.Y := 18;
  LRectImg.Width := 88;
  LRectImg.Height := 88;
  LRectImg.XRadius := 44;
  LRectImg.YRadius := 44;
  LRectImg.Fill.Kind := TBrushKind.Solid;
  LRectImg.Fill.Color := TTheme.CorPrincipalLight;
  LRectImg.Stroke.Kind := TBrushKind.None;
  LRectImg.HitTest := False;

  LLblEmoji := TLabel.Create(Self);
  LLblEmoji.Parent := LRectImg;
  LLblEmoji.Align := TAlignLayout.Client;
  LLblEmoji.Text := Char($D83C) + Char($DF89); // party popper default
  LLblEmoji.StyledSettings := [];
  LLblEmoji.TextSettings.Font.Size := 40;
  LLblEmoji.TextSettings.HorzAlign := TTextAlign.Center;
  LLblEmoji.TextSettings.VertAlign := TTextAlign.Center;
  LLblEmoji.HitTest := False;

  { Nome }
  LLblNome := TLabel.Create(Self);
  LLblNome.Parent := Result;
  LLblNome.Align := TAlignLayout.None;
  LLblNome.Position.X := 8;
  LLblNome.Position.Y := 120;
  LLblNome.Width := CARD_WIDTH - 16;
  LLblNome.Height := 44;
  LLblNome.Text := AProduto.Nome;
  LLblNome.StyledSettings := [];
  LLblNome.TextSettings.Font.Size := TTheme.FontNormal;
  LLblNome.TextSettings.Font.Style := [TFontStyle.fsBold];
  LLblNome.TextSettings.FontColor := TTheme.CorTexto;
  LLblNome.TextSettings.HorzAlign := TTextAlign.Center;
  LLblNome.TextSettings.VertAlign := TTextAlign.Center;
  LLblNome.TextSettings.WordWrap := True;
  LLblNome.HitTest := False;

  { Preco }
  LLblPreco := TLabel.Create(Self);
  LLblPreco.Parent := Result;
  LLblPreco.Align := TAlignLayout.None;
  LLblPreco.Position.X := 8;
  LLblPreco.Position.Y := 170;
  LLblPreco.Width := CARD_WIDTH - 16;
  LLblPreco.Height := 30;
  LLblPreco.Text := FormatarMoeda(AProduto.Preco_Venda);
  LLblPreco.StyledSettings := [];
  LLblPreco.TextSettings.Font.Size := TTheme.FontPrice;
  LLblPreco.TextSettings.Font.Style := [TFontStyle.fsBold];
  LLblPreco.TextSettings.FontColor := TTheme.CorPrincipal;
  LLblPreco.TextSettings.HorzAlign := TTextAlign.Center;
  LLblPreco.TextSettings.VertAlign := TTextAlign.Center;
  LLblPreco.HitTest := False;

  { Badge de estoque baixo }
  if AProduto.Estoque_Atual <= AProduto.Estoque_Minimo then
  begin
    LBadge := TRectangle.Create(Self);
    LBadge.Parent := Result;
    LBadge.Position.X := CARD_WIDTH - 52;
    LBadge.Position.Y := 12;
    LBadge.Width := 40;
    LBadge.Height := 22;
    LBadge.XRadius := 11;
    LBadge.YRadius := 11;
    LBadge.Fill.Kind := TBrushKind.Solid;
    LBadge.Fill.Color := TTheme.CorErro;
    LBadge.Stroke.Kind := TBrushKind.None;
    LBadge.HitTest := False;

    LLblBadge := TLabel.Create(Self);
    LLblBadge.Parent := LBadge;
    LLblBadge.Align := TAlignLayout.Client;
    LLblBadge.Text := IntToStr(AProduto.Estoque_Atual);
    LLblBadge.StyledSettings := [];
    LLblBadge.TextSettings.Font.Size := TTheme.FontSmall;
    LLblBadge.TextSettings.Font.Style := [TFontStyle.fsBold];
    LLblBadge.TextSettings.FontColor := TTheme.CorTextoBranco;
    LLblBadge.TextSettings.HorzAlign := TTextAlign.Center;
    LLblBadge.TextSettings.VertAlign := TTextAlign.Center;
    LLblBadge.HitTest := False;
  end;
end;

procedure TFrmPDV.CardMouseEnter(Sender: TObject);
begin
  if Sender is TRectangle then
  begin
    TRectangle(Sender).Stroke.Color := TTheme.CorPrincipal;
    TControl(Sender).SetEscala(1.03);
  end;
end;

procedure TFrmPDV.CardMouseLeave(Sender: TObject);
begin
  if Sender is TRectangle then
  begin
    TRectangle(Sender).Stroke.Color := TTheme.CorBorda;
    TControl(Sender).SetEscala(1.0);
  end;
end;

procedure TFrmPDV.ProdutoCardClick(Sender: TObject);
var
  LProduto: TProduto;
begin
  if not (Sender is TRectangle) then
    Exit;
  LProduto := GetProdutoPorId(TRectangle(Sender).Tag);
  if not Assigned(LProduto) then
    Exit;
  try
    FControllerVenda.AdicionarProduto(LProduto, 1);
    AtualizarCarrinho;
  except
    on E: Exception do
      TDialogService.ShowMessage(E.Message);
  end;
end;

{ ============================================================
  CARRINHO
  ============================================================ }

procedure TFrmPDV.AtualizarCarrinho;
begin
  RenderizarItensCarrinho;
  AtualizarTotais;
end;

procedure TFrmPDV.RenderizarItensCarrinho;
var
  I: Integer;
  LItem: TVendaItem;
  LProduto: TProduto;
  LCard: TRectangle;
  LLayBtns: TLayout;
  LLayInfo: TLayout;
  LLblNome: TLabel;
  LRowInfo: TLayout;
  LLblQtd: TLabel;
  LLblSubtotal: TLabel;
  LBtnMais, LBtnMenos, LBtnRemover: TRectangle;
  LLblMais, LLblMenos, LLblRemover: TLabel;
begin
  ScrollItens.Content.DeleteChildren;

  for I := 0 to FControllerVenda.Carrinho.Count - 1 do
  begin
    LItem := FControllerVenda.Carrinho[I];
    LProduto := GetProdutoPorId(LItem.Produto_Id);

    LCard := TRectangle.Create(Self);
    LCard.Parent := ScrollItens;
    LCard.Align := TAlignLayout.Top;
    LCard.Height := 76;
    LCard.Margins.Left := 16;
    LCard.Margins.Right := 16;
    LCard.Margins.Top := 8;
    LCard.XRadius := 12;
    LCard.YRadius := 12;
    LCard.Fill.Kind := TBrushKind.Solid;
    LCard.Fill.Color := TTheme.CorFundo;
    LCard.Stroke.Kind := TBrushKind.None;
    LCard.HitTest := False;
    LCard.Tag := I;

    { Botoes a direita (-, +, x) }
    LLayBtns := TLayout.Create(Self);
    LLayBtns.Parent := LCard;
    LLayBtns.Align := TAlignLayout.Right;
    LLayBtns.Width := 116;

    LBtnRemover := TRectangle.Create(Self);
    LBtnRemover.Parent := LLayBtns;
    LBtnRemover.Align := TAlignLayout.Right;
    LBtnRemover.Width := 32;
    LBtnRemover.Margins.Right := 10;
    LBtnRemover.Margins.Top := 22;
    LBtnRemover.Margins.Bottom := 22;
    LBtnRemover.XRadius := 8;
    LBtnRemover.YRadius := 8;
    LBtnRemover.Fill.Kind := TBrushKind.Solid;
    LBtnRemover.Fill.Color := TTheme.CorFundoSecundario;
    LBtnRemover.Stroke.Kind := TBrushKind.None;
    LBtnRemover.Cursor := crHandPoint;
    LBtnRemover.Tag := I;
    LBtnRemover.OnClick := BtnRemoverClick;
    LLblRemover := TLabel.Create(Self);
    LLblRemover.Parent := LBtnRemover;
    LLblRemover.Align := TAlignLayout.Client;
    LLblRemover.Text := Char($00D7);
    LLblRemover.StyledSettings := [];
    LLblRemover.TextSettings.Font.Size := 16;
    LLblRemover.TextSettings.FontColor := TTheme.CorErro;
    LLblRemover.TextSettings.HorzAlign := TTextAlign.Center;
    LLblRemover.TextSettings.VertAlign := TTextAlign.Center;
    LLblRemover.HitTest := False;

    LBtnMais := TRectangle.Create(Self);
