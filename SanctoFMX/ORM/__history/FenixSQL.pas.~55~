function TFenixSQL<T>.LastID(): string;
const
  SQL = 'SELECT FIRST(1) %s FROM %s ORDER BY %s DESC';
begin
  var
    lClassName,
    lPK: String;

  FFenixRTTi.TableName(lClassName);
  FFenixRTTi.PrimaryKey(lPK);

  Result := Format(SQL, [lPK, lClassName, lPK]);
end;

